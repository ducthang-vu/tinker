{
  "name": "tinker",
  "version": "0.0.1",
  "description": "A tiny frontend framework, built to learn how frameworks work.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "build:example": "vite build examples/basics --config vite.config.ts --base ./ --outDir ../../dist/example --emptyOutDir",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix .",
    "test": "vitest run && npm run test:repo-map && npm run repo-map:check",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "repo-map": "node scripts/repo-map.mjs",
    "repo-map:check": "node scripts/repo-map.mjs --format markdown --stdout | diff - .repo-map.md || (echo 'The repo map is out of date: run npm run repo-map -- --format markdown' && exit 1)",
    "test:repo-map": "node --test scripts/repo-map.test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "10.14.0",
    "jsdom": "^31.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
