{
  "name": "@tinker/compiler",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@babel/core": "^8.1.2",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-syntax-typescript": "^8.0.3",
